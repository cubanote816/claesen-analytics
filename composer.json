{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "anthropic-ai/sdk": "^0.42.0",
        "barryvdh/laravel-dompdf": "^3.1",
        "filament/filament": "^5.7",
        "filament/spatie-laravel-media-library-plugin": "^5.7",
        "lara-zeus/spatie-translatable": "^2.0",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.26",
        "laravel/tinker": "^3.0",
        "nwidart/laravel-modules": "^13.0",
        "resend/resend-laravel": "^1.4",
        "socialiteproviders/microsoft-azure": "^5.2",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-permission": "^8.0",
        "spatie/laravel-query-builder": "^7.0",
        "spatie/laravel-translatable": "^6.14",
        "symfony/css-selector": "^8.0",
        "symfony/dom-crawler": "^8.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.7",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.67",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.5",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\FieldOps\\Database\\Factories\\": "Modules/FieldOps/database/factories/",
            "Modules\\FieldOps\\Database\\Seeders\\": "Modules/FieldOps/database/seeders/",
            "Modules\\Intelligence\\Database\\Seeders\\": "Modules/Intelligence/database/seeders/",
            "Modules\\Mailing\\Database\\Factories\\": "Modules/Mailing/database/factories/",
            "Modules\\Mailing\\Database\\Seeders\\": "Modules/Mailing/database/seeders/",
            "Modules\\Prospects\\Database\\Factories\\": "Modules/Prospects/database/factories/",
            "Modules\\Safety\\Database\\Factories\\": "Modules/Safety/database/factories/",
            "Modules\\Safety\\Database\\Seeders\\": "Modules/Safety/database/seeders/",
            "Modules\\Website\\Database\\Factories\\": "Modules/Website/database/factories/",
            "Modules\\": "Modules/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Modules\\Intelligence\\Tests\\": "Modules/Intelligence/tests/",
            "Modules\\Mailing\\Tests\\": "Modules/Mailing/tests/",
            "Modules\\Prospects\\Tests\\": "Modules/Prospects/tests/",
            "Modules\\Safety\\Tests\\": "Modules/Safety/tests/",
            "Modules\\Website\\Tests\\": "Modules/Website/tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
