APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# For cross-origin SPAs set to "none" (requires HTTPS). Same-domain: keep "lax".
SESSION_SAME_SITE=lax

# SPA / browser-first frontends — required for Sanctum stateful cookie auth
FRONTEND_URL=http://localhost:5173
# Target production hostname: https://client.claesen-verlichting.be (per
# docs/ai/known-risks.md / fieldops-maintenance-roadmap.md) - not yet
# provisioned (DNS/TLS/nginx). Set only once infrastructure/nginx/sbapu03/
# client.claesen-verlichting.be.conf is applied; see docs/ai/production-readiness.md.
CLIENT_PORTAL_URL=
# Comma-separated list of stateful SPA domains (overrides Sanctum default list)
# CLIENT_PORTAL_URL is also appended automatically when configured.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Redirect ALL outgoing mail (default mailer + the named microsoft-graph mailer)
# to these addresses — dev/staging safety net. Comma-separated. Leave empty in production.
MAIL_TO_ADDRESS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Mailing campaign transport. Read via config('app.mailing_driver'). Values:
#   microsoft-graph — real send via Microsoft Graph
#   simulation      — no send, logs only (dev/staging; refused in production)
#   saas            — ESP stub, MAI-026 (no send)
# Fail-closed: if unset (or any unknown value) the app raises
# MailConfigurationException before sending — there is no implicit default.
MAILING_DRIVER=simulation

# Performance module — AI insights
PERFORMANCE_AI_LOCALE=nl

# Performance / Watchdog — recipients & thresholds (read via config('performance.watchdog.*')).
# No recipient => the command fails / logs a warning and sends nothing.
WATCHDOG_REPORT_EMAIL=
WATCHDOG_VANGUARD_EMAIL=
WATCHDOG_IMMEDIATE_THRESHOLD=20000
WATCHDOG_SYNC_YEARS_BACK=5

# Azure AD group GUID -> local role (read via config('core.azure_role_mapping')).
# Unset entries are ignored; users with no mapped group fall back to 'viewer'.
AZURE_GROUP_SUPER_ADMIN=
AZURE_GROUP_ADMIN=
AZURE_GROUP_FINANCE=
AZURE_GROUP_PM=

# Website — internal recipient for the "new consultation request" notification
# (read via config('website.consultation_notification_email')). Empty => skipped.
WEBSITE_CONSULTATION_EMAIL=

# Safety module — PWA link included in inspection reminder emails
SAFETY_PWA_URL=https://service.claesen-verlichting.be/

# Safety module — recipients for inspection/incident report emails (comma-separated)
SAFETY_REPORT_RECIPIENTS=bert.bertels@claesen-verlichting.be

# CLA-440 — OpenAI, frame-type illustration generation (CLA-390 Fase 3)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=low
OPENAI_NAME_MODEL=gpt-5.4-nano-2026-03-17
